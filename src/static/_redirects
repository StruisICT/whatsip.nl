# Cloudflare Pages redirects.
# Sept 2026: the site is now FLAT (/, /ipv6, /browser, ...) with client-side
# language switching. There is no language router and no per-visit redirect.
# Pages (/*.html) and functions (/ip, /api/*) are served directly.

# Redirect www to apex domain (must configure www.whatsip.nl as custom domain in Cloudflare Pages)
https://www.whatsip.nl/* https://whatsip.nl/:splat 301

# Legacy pages removed in the July 2026 trim (were indexed)
/en/faq /about 301
/nl/faq /about 301
/en/dns / 301
/nl/dns / 301
/en/speed / 301
/nl/speed / 301

# Legacy localized URLs (/en/*, /nl/*) -> flat path. One-time for old inbound
# links / search results; normal navigation never hits these.
/en/* /:splat 301
/nl/* /:splat 301
